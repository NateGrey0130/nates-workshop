# Copy to .dev.vars for local development (.dev.vars is gitignored).
# In production these are set in the Cloudflare Pages dashboard instead:
#   Settings -> Environment variables

# Anthropic API key used by functions/api/claude.js (FilamentForge + class import).
ANTHROPIC_API_KEY=sk-ant-...

# The single email allowed to use admin-only features (the OCC/RCC class import).
# Locally, Cloudflare Access isn't in front of the site and the identity helper
# falls back to dev@localhost, so use that to exercise admin locally.
# In production set this to your real Access email.
ADMIN_EMAIL=dev@localhost

# MediaVault's video metadata lookups (functions/api/media-vault/lookup.js).
# Only the video-* modes need it - ISBN and book lookups go to OpenLibrary and
# work without one. Leave it unset and those three answer 503 while the rest of
# MediaVault carries on, which is how its absence goes unnoticed.
# TMDB's 32-character v3 API key, NOT a v4 read access token.
TMDB_API_KEY=

# Who MediaVault's share picker may offer (functions/api/media-vault/shares.js):
# a hand-kept mirror of the Cloudflare Access allow policy, comma- or
# whitespace-separated. shares.js re-checks it on every grant, so the picker
# cannot be bypassed by calling the endpoint directly.
# UNSET MEANS NOBODY - sharing refuses, the way ADMIN_EMAIL fails closed.
# Locally, identity falls back to dev@localhost, which is not an email shape and
# can never be a candidate; use a header identity to exercise sharing.
MV_SHARE_CANDIDATES=
