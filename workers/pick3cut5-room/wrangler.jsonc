{
  // Published URL, not 'node_modules/wrangler/config-schema.json': this repo has
  // no package.json and no node_modules, so the path every wrangler init writes
  // resolves to nothing here. Editors validate this file against the URL instead.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "pick3cut5-room",
  "main": "src/index.js",
  "compatibility_date": "2026-04-19",

  // Off on purpose. This Worker is reachable ONLY through the two bindings the
  // Pages project holds (see the root wrangler.jsonc). Leaving workers.dev on
  // would put the room API and the generation endpoint on a second public
  // hostname that nothing in front of it - not Access, not the room code -
  // would be guarding.
  "workers_dev": false,

  // Free on Workers and unavailable on Pages, which is most of the argument in
  // docs/pages-to-workers-migration.md in one line. When a room misbehaves in
  // production this is the only way to find out why.
  "observability": { "enabled": true },

  // Model strings are configuration, not code. The classifier runs on the
  // small model deliberately: it is the cheap gate that decides whether the
  // expensive search-enabled calls happen at all. It also CANNOT search even
  // if asked - the current web search tool needs a 4.6-or-later model - which
  // is a useful thing to have enforced by the model choice rather than by a
  // flag someone can flip.
  "vars": {
    "P3C5_MODEL_CLASSIFY": "claude-haiku-4-5-20251001",
    "P3C5_MODEL_GENERATE": "claude-sonnet-5",
    "P3C5_MODEL_VERIFY": "claude-sonnet-5"
  },

  // Spend visibility ONLY. No game state touches D1 — rooms still live and die
  // in Durable Object memory, which is the app's no-database rule as intended.
  //
  // This exists because Pick 3 Cut 5 is the one path in the Workshop a stranger
  // can make spend money, and it was also the one path reporting nothing: the
  // `claude_usage` query in SETUP.md silently excluded it. Rows land with a null
  // email (there is no identity here by design) and an endpoint of
  // `pick3cut5-party` or `pick3cut5-solo`.
  //
  // Writes are fail-open. Metering must never break the call it measures.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nates-workshop-media",
      "database_id": "6de15679-1b2e-4f87-8dc2-ac64b24e33d2"
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },

  // The room code is the DO name, so this namespace is the whole lookup table.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],

  // Solo mode's guardrail. Pages Functions cannot use this binding at all,
  // which is why /solo/generate lives in this Worker rather than next to the
  // other API routes.
  //
  // `period` accepts only 10 or 60. Eight generations a minute is far more
  // than a person playing solo will ever want and far less than a script
  // wants. The global bucket underneath is the blast radius cap for when the
  // per-IP one is defeated by simply having more IPs.
  //
  // THE GLOBAL CAP IS SIZED IN MONEY, NOT REQUESTS. A verified generation was
  // measured at ~57,000 input tokens and roughly $0.19 — about eighty times an
  // unverified one — and the caller picks the category, so anyone can reach
  // that path just by asking for something time-sensitive. At the original 60
  // per minute the ceiling was near $860/hour; at 12 it is under $180, while
  // still leaving six times the headroom a household of players needs.
  "ratelimits": [
    {
      "name": "SOLO_LIMIT",
      "namespace_id": "3501",
      "simple": { "limit": 8, "period": 60 }
    },
    {
      "name": "SOLO_LIMIT_GLOBAL",
      "namespace_id": "3502",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
