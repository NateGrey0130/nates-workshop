{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nates-workshop",
  "compatibility_date": "2026-04-19",
  "pages_build_output_dir": ".",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Arms the Access JWT verification in functions/api/_middleware.js: every
  // /api/* request must carry a token signed by this team, for this
  // application. NEITHER VALUE IS A SECRET - the AUD tag rides in every login
  // redirect URL - and this project manages plain variables here rather than
  // in the dashboard (the dashboard holds only the two encrypted secrets).
  //
  // These reach `wrangler pages dev` too, where no Access exists to mint a
  // token; the middleware exempts localhost for exactly that reason, the same
  // reality auth.js's dev@localhost fallback answers. Preview deployments
  // built from this config are armed as well - they sit OUTSIDE Access, so
  // arming them turns their /api/* into a wall rather than an open door.
  //
  // To stand down: remove both (the middleware passes through unless both are
  // set) and merge.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "fatmans.cloudflareaccess.com",
    "ACCESS_AUD": "2496fc92a44613095fab0041f70ad421f2539ddf0fa5dbb7994cc0d514c4ebd3"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nates-workshop-media",
      "database_id": "6de15679-1b2e-4f87-8dc2-ac64b24e33d2"
    }
  ],
  // The site's first R2 bucket. Named for the SITE rather than for the app that
  // needed it first: MediaVault stores cover art as text today and
  // filament-forge already reads file bytes, so the second and third users
  // exist. Nothing is ever served from a public bucket URL - every read goes
  // through a Function that checks who is asking, because the whole site sits
  // behind Access and an open image endpoint would be the one hole in it.
  //
  // The bucket must EXIST before the deploy that binds it, same discipline as a
  // migration: create it, then verify by listing it back. See SETUP.md.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nates-workshop-media"
    }
  ],
  // Pick 3 Cut 5's room server. BOTH of these point at the same standalone
  // Worker, `pick3cut5-room`, whose source lives in workers/pick3cut5-room/.
  //
  // WHY A SECOND WORKER EXISTS AT ALL: a Pages project cannot define a Durable
  // Object class - it can only bind to one exported from a standalone Worker,
  // and unlike Workers, Pages requires `script_name` on the binding. That is a
  // current documented limitation, not a legacy one. The alternative was
  // migrating the whole site off Pages; docs/pages-to-workers-migration.md is
  // that option, written up and not taken.
  //
  // THE DEPLOY ORDER MATTERS AND IT IS NOT ENFORCED. Merging to main deploys
  // Pages and does NOT deploy this Worker. The Worker must be deployed FIRST -
  // same discipline as the R2 bucket above - or these bindings resolve to
  // nothing and party mode answers 503 while the rest of the site looks fine.
  // SETUP.md carries the order.
  //
  // Two bindings rather than one because they do different jobs: the Durable
  // Object binding carries the WebSocket straight to the room's stub, and the
  // service binding carries plain HTTP (room creation, solo generation) to the
  // Worker's fetch handler, where the rate limit binding that Pages cannot use
  // is waiting.
  "durable_objects": {
    "bindings": [
      {
        "name": "P3C5_ROOM",
        "class_name": "Room",
        "script_name": "pick3cut5-room"
      }
    ]
  },
  "services": [
    {
      "binding": "PICK3CUT5",
      "service": "pick3cut5-room"
    }
  ]
}
