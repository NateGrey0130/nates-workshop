{
  // Published URL, not 'node_modules/wrangler/config-schema.json': this repo has
  // no package.json and no node_modules, so the path every wrangler init writes
  // resolves to nothing here. Editors validate this file against the URL instead.
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "nates-workshop",
  "compatibility_date": "2026-04-19",
  "pages_build_output_dir": ".",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Arms the Access JWT verification in functions/api/_middleware.js: every
  // /api/* request must carry a token signed by this team, for this
  // application. NEITHER VALUE IS A SECRET - the AUD tag rides in every login
  // redirect URL - and this project manages plain variables here rather than
  // in the dashboard (the dashboard holds only the two encrypted secrets).
  //
  // These reach `wrangler pages dev` too, where no Access exists to mint a
  // token; the middleware exempts localhost for exactly that reason, the same
  // reality auth.js's dev@localhost fallback answers. Preview deployments
  // are armed as well, in env.preview below, with the same team and the AUD
  // of the preview hosts' own Access application.
  //
  // To stand down: remove both (the middleware passes through unless both are
  // set) and merge.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "fatmans.cloudflareaccess.com",
    "ACCESS_AUD": "2496fc92a44613095fab0041f70ad421f2539ddf0fa5dbb7994cc0d514c4ebd3"
  },
  // ONE D1 PER GROUP OF APPS (groups.json), since 2026-09-25. `DB` is
  // Palladium's: the character creator and the apps split from it. Its name,
  // nates-workshop-media, is older than the split - the database was first
  // made for MediaVault - and a D1 cannot be renamed, so the name is wrong on
  // purpose rather than by accident. `DB_MARVEL` and `DB_TOOLS` hold the Marvel
  // app's and the tools' tables (FilamentForge, MediaVault). A group's code
  // names only its own tables and reaches only its own binding - groups.json gives each group its d1_binding, and groups.mjs
  // --check fails on either, and on a binding here that no group has.
  //
  // The tables moved one group at a time, each in the pull request that
  // switched its code to its binding, and all three had moved on 2026-09-25.
  // Their old copies stayed in DB as a rollback until migration 085 dropped
  // them, after a last row-for-row compare and a backup of all three.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nates-workshop-media",
      "database_id": "6de15679-1b2e-4f87-8dc2-ac64b24e33d2"
    },
    {
      "binding": "DB_MARVEL",
      "database_name": "nates-workshop-marvel",
      "database_id": "0bdb8253-17ee-44cd-9e48-a8b4b0c335a3"
    },
    {
      "binding": "DB_TOOLS",
      "database_name": "nates-workshop-tools",
      "database_id": "e8544468-4698-48c1-adf1-298cd6f212e6"
    }
  ],
  // The site's first R2 bucket. Named for the SITE rather than for the app that
  // needed it first: MediaVault stores cover art as text today and
  // filament-forge already reads file bytes, so the second and third users
  // exist. Nothing is ever served from a public bucket URL - every read goes
  // through a Function that checks who is asking, because the whole site sits
  // behind Access and an open image endpoint would be the one hole in it.
  //
  // The bucket must EXIST before the deploy that binds it, same discipline as a
  // migration: create it, then verify by listing it back. See SETUP.md.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nates-workshop-media"
    }
  ],
  // TABLE_ROOM is The Table's live game room, the standalone Worker
  // `table-room`, whose source lives in workers/table-room/.
  //
  // WHY A SEPARATE WORKER EXISTS AT ALL: a Pages project cannot define a
  // Durable Object class - it can only bind to one exported from a standalone
  // Worker, and unlike Workers, Pages requires `script_name` on the binding.
  // That is a current documented limitation, not a legacy one. The alternative
  // was migrating the whole site off Pages; docs/pages-to-workers-migration.md
  // is that option, written up and not taken.
  //
  // THE DEPLOY ORDER MATTERS AND IT IS NOT ENFORCED. Merging to main deploys
  // Pages and does NOT deploy this Worker. `node scripts/deploy-table-room.mjs`
  // must run BEFORE the merge that first binds it - same discipline as the R2
  // bucket above - or the binding resolves to nothing and every /table/ route
  // answers 503 while the rest of the site looks fine. SETUP.md carries the
  // order. It sits behind Access: its routes are under each game's own /api/
  // directory.
  "durable_objects": {
    "bindings": [
      {
        "name": "TABLE_ROOM",
        "class_name": "TableRoom",
        "script_name": "table-room"
      }
    ]
  },
  // PULL-REQUEST PREVIEWS GET THEIR OWN DATA. Pages builds a preview from the
  // top level above unless this block overrides it, so before 2026-10-27 every
  // preview read and wrote production's three D1s and its bucket. Local dev
  // (`wrangler pages dev`) and production still read the top level.
  //
  // Pages' rule: override one non-inheritable key (vars or any binding) and
  // every one of them must be restated here, or the deploy fails validation.
  // So the Access vars are restated - same team, but ACCESS_AUD is the AUD of
  // the separate Access application on *.nates-workshop.pages.dev, because a
  // preview's token is minted for that one (production's AUD here refused
  // every preview /api/* call with "audience mismatch") - and so is the room
  // Worker, which has no preview copy: a preview's Table rooms are
  // production's Worker.
  //
  // The databases hold what the repo builds, never production's rows:
  // `node scripts/build-preview-d1.mjs` rebuilds them (SETUP.md -> The preview
  // D1 databases), and nothing rebuilds them as data scripts merge. The bucket
  // was made empty in the dashboard. groups.mjs --check rule 8 holds this
  // block to production's binding names and to -preview resources.
  "env": {
    "preview": {
      "vars": {
        "ACCESS_TEAM_DOMAIN": "fatmans.cloudflareaccess.com",
        "ACCESS_AUD": "5cf151878cf87ab119b337755b8e841d84aa41f766644c52399a2cca42ed2eaa"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nates-workshop-media-preview",
          "database_id": "1c5f3ddb-ae56-4be3-b13e-f34eae720405"
        },
        {
          "binding": "DB_MARVEL",
          "database_name": "nates-workshop-marvel-preview",
          "database_id": "750a8ae5-eb89-4625-996f-8d84a86165a0"
        },
        {
          "binding": "DB_TOOLS",
          "database_name": "nates-workshop-tools-preview",
          "database_id": "329ff05e-e217-4128-8817-33c274696430"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "nates-workshop-media-preview"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "TABLE_ROOM",
            "class_name": "TableRoom",
            "script_name": "table-room"
          }
        ]
      }
    }
  }
}
